<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Cafetera" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/coffee_brown</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/coffee_brown</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/cream</item>
    </style>

    <style name="Theme.Cafetera.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/coffee_brown</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Cafetera.SplashScreen</item>
    </style>

    <style name="Theme.Cafetera.SplashScreen" parent="Theme.Cafetera">
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowBackground">@color/cream</item>
    </style>
</resources>
